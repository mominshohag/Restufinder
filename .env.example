# === Restaurant Data ===
# Google Places API key (optional — app falls back to free OpenStreetMap/Overpass API)
# Get one at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# === Social Media / Discount Fetching ===
# Facebook App credentials (optional — needed to read public page posts for discounts)
# Create a free app at: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# === Server ===
PORT=3001
NODE_ENV=development
